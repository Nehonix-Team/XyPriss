{
    "watch": ["."],
    "ignore": ["node_modules", "dist", ".git"],
    "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
    "runner": "xfpm",
    "nodeArgs": null,
    "envFile": "",
    "clearScreen": true,
    "batchMode": false,
    "debounceMs": 100,
    "maxRestarts": -1,
    "useFileHash": true,
    "gracefulMs": 3000,
    "silent": false,
    "noSignals": false,
    "targetFile": ""
}
