{
    "$internal": {
        "xyphra": {
            "permissions": {
                "allowedHooks": [
                    "XHS.HOOK.HTTP.REQUEST",
                    "XHS.HOOK.LIFECYCLE.SERVER_START",
                ],
            },
            "signature": {
                "author_key": "ed25519:da16560012a6baef17647360c791646ccf63ed6d03139e759aa7fd0591086b12",
            },
        },

        "xypriss-swagger": {
            "permissions": {
                "allowedHooks": [
                    "XHS.HOOK.LIFECYCLE.REGISTER",
                    "XHS.HOOK.LIFECYCLE.SERVER_START",
                    "XHS.PERM.OPS.AUXILIARY_SERVER",
                    "XHS.PERM.ROUTING.REGISTER_ROUTES",
                    "XHS.PERM.ROUTING.BYPASS_NAMESPACE",
                ],
            },
            "signature": {
                "author_key": "ed25519:da16560012a6baef17647360c791646ccf63ed6d03139e759aa7fd0591086b12",
            },
            "__xfs__": {
                "path": "CWD://.",
            },
            "__meta__": {
                "path": "CWD://.",
            },
        },
    },
    "$vars": {
        "__PORT__": "\u0026(env).PORT || 8716",
        "__alias__": "\u0026(env).ALIAS",
        "__author__": "\u0026(env).AUTHOR",
        "__description__": "The desc: \u0026(env).DESCRIPTION",
        "__name__": "\u0026(env).TEST || \u0026(env).NAME",
        "__project_name__": "\u0026(pkg).name",
        "__version__": "\u0026(env).VERSION",
        "servers": {
            "auth": {
                "port": "&(env).AUTH_SERVER_PORT || 9182",
                "id": "&(env).AUTH_DOMAIN || rest.auth.domain.com",
            },
            "main": {
                "port": "&(env).MAIN_SERVER_PORT || 1822",
                "id": "&(env).MAIN_DOMAIN || rest.api.domain.com",
            },
            "cdn": {
                "port": "&(env).CDN_SERVER_PORT || 5829",
                "id": "&(env).CDN_DOMAIN || rest.cdn.domain.com",
            },
        },
    },
}

