{
    "script": "./src/server.ts",
    "watch": ["src"],
    "ignore": ["node_modules", "dist", ".git", "logs"],
    "extensions": [
        ".ts",
        ".tsx",
        ".json",
        ".js",
        ".jsx",
        ".cjs",
        ".jsonc",
        ".mjs"
    ],
    "runner": "xfpm",
    "nodeArgs": null,
    "envFile": "",
    "clearScreen": true,
    "batchMode": false,
    "debounceMs": 100,
    "maxRestarts": -1,
    "useFileHash": true,
    "gracefulMs": 3000,
    "silent": false,
    "noSignals": false,
    "targetFile": ""
}

